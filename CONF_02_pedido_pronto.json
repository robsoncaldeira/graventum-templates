{
  "name": "[[TEMPLATE]] CONF_02 Pedido Pronto — Aviso e Lembretes",
  "nodes": [
    {
      "id": "wh-conf02",
      "name": "Webhook Pedido Pronto",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "conf02-pedido-pronto",
      "parameters": {
        "path": "confeccao/pedido-pronto",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "code-conf02",
      "name": "Preparar Aviso Pronto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst nome = b.cliente_nome || 'Cliente';\nconst tipo = b.tipo || 'seu serviço';\nconst telefone = (b.cliente_telefone || '').replace(/\\D/g,'');\nconst saldo = b.saldo_devedor ? parseFloat(b.saldo_devedor) : 0;\nconst saldoTxt = saldo > 0 ? `\\n\\nSaldo a pagar na retirada: R$ ${saldo.toFixed(2)}` : '';\nconst automationId = '{{CLIENT_AUTOMATION_ID}}';\n\nconst texto = `Olá, ${nome}! ${tipo} está pronto para retirada. 🎉${saldoTxt}\\n\\nEstamos aguardando você!`;\n\nreturn [{json: {\n  telefone,\n  texto,\n  waUrl: `http://evolution_api:8080/message/sendText/{{CLIENT_WA_INSTANCE}}`,\n  waKey: '{{CLIENT_EVOLUTION_API_KEY}}',\n  automationId\n}}];"
      }
    },
    {
      "id": "http-wa-conf02",
      "name": "Enviar WA Pronto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.waUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.waKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {number: $json.telefone, text: $json.texto, delay: 1000} }}",
        "options": {}
      }
    },
    {
      "id": "code-metrics-conf02",
      "name": "Registrar Histórico",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "return [{json: {\n  automation_id: '{{CLIENT_AUTOMATION_ID}}',\n  metric_key: 'avisos_pronto_enviados',\n  metric_value: 1,\n  metadata: {timestamp: new Date().toISOString()}\n}}];"
      }
    }
  ],
  "connections": {
    "Webhook Pedido Pronto": {
      "main": [
        [
          {
            "node": "Preparar Aviso Pronto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Aviso Pronto": {
      "main": [
        [
          {
            "node": "Enviar WA Pronto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar WA Pronto": {
      "main": [
        [
          {
            "node": "Registrar Histórico",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null
}