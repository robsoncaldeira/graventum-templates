    "Marcar como Ativo": { "main": [[{ "node": "Notificar Sucesso Telegram", "type": "main", "index": 0 }]] },
    "Notificar Sucesso Telegram": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] },
