{
  "name": "[[TEMPLATE]] Follow-up Sequence",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 12 }]
        }
      },
      "id": "trigger-cron",
      "name": "Cron 2x por Dia",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://ckjiixentlgitwqoquzm.supabase.co/rest/v1/client_automations_leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "automation_id", "value": "=eq.{{CLIENT_AUTOMATION_ID}}" },
            { "name": "status", "value": "=in.(primeiro_contato,aguardando_resposta)" },
            { "name": "proximo_followup_em", "value": "=lte." }
          ]
        }
      },
      "id": "get-pending-leads",
      "name": "Buscar Leads Pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.first().json;\nconst now = new Date();\n\nconst FOLLOWUP_MESSAGES = [\n  { dias: 0, msg: 'Oi {nome}! Passando para saber se teve oportunidade de pensar na nossa conversa. Tem alguma dúvida que posso ajudar?' },\n  { dias: 3, msg: '{nome}, tudo bem? Sei que o dia a dia é corrido. Queria entender melhor a situação de vocês — qual parte do processo você mais gostaria de otimizar hoje?' },\n  { dias: 7, msg: 'Oi {nome}! Última vez que entramos em contato. Caso queira retomar a conversa no futuro, é só chamar. Abraços!' }\n];\n\nconst toSend = [];\nfor (const lead of leads) {\n  const step = Math.min(lead.followup_step || 0, FOLLOWUP_MESSAGES.length - 1);\n  const template = FOLLOWUP_MESSAGES[step];\n  toSend.push({\n    json: {\n      lead_id: lead.id,\n      telefone: lead.telefone,\n      step: step,\n      next_step: step + 1,\n      msg: template.msg.replace('{nome}', lead.nome?.split(' ')[0] || 'tudo bem'),\n      is_last: step >= FOLLOWUP_MESSAGES.length - 1\n    }\n  });\n}\nreturn toSend;"
      },
      "id": "build-messages",
      "name": "Montar Mensagens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8081/message/sendText/{{CLIENT_WA_INSTANCE}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{CLIENT_EVOLUTION_API_KEY}}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "number", "value": "={{ $json.telefone }}" },
            { "name": "text", "value": "={{ $json.msg }}" }
          ]
        }
      },
      "id": "send-followup",
      "name": "Enviar Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://ckjiixentlgitwqoquzm.supabase.co/rest/v1/client_automations_leads?id=eq.{{ $('Montar Mensagens').first().json.lead_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={ \"followup_step\": {{ $('Montar Mensagens').first().json.next_step }}, \"status\": \"{{ $('Montar Mensagens').first().json.is_last ? 'finalizado' : 'aguardando_resposta' }}\", \"proximo_followup_em\": \"{{ new Date(Date.now() + 3*86400000).toISOString() }}\" }"
      },
      "id": "update-lead",
      "name": "Atualizar Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Cron 2x por Dia": { "main": [[{ "node": "Buscar Leads Pendentes", "type": "main", "index": 0 }]] },
    "Buscar Leads Pendentes": { "main": [[{ "node": "Montar Mensagens", "type": "main", "index": 0 }]] },
    "Montar Mensagens": { "main": [[{ "node": "Enviar Follow-up", "type": "main", "index": 0 }]] },
    "Enviar Follow-up": { "main": [[{ "node": "Atualizar Lead", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "_meta": {
    "template_key": "followup-sequence",
    "description": "Sequência D+0/D+3/D+7 de follow-up via WhatsApp para leads que não responderam. Trabalha em conjunto com qualificacao-leads-wa.",
    "api_keys_required": [],
    "variables": ["CLIENT_AUTOMATION_ID", "CLIENT_WA_INSTANCE", "CLIENT_EVOLUTION_API_KEY"]
  }
}
